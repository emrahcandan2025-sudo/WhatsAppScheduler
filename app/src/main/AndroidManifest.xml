<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Zamanlanmış alarmı tam saatinde tetiklemek için (Android 12+) -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <!-- Telefon yeniden başladığında bekleyen alarmları tekrar kurmak için -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Android 13+ bildirim izni (full-screen intent bildirimi için artık zorunlu) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Ekran kapalı/kilitliyken WhatsAppLaunchActivity'yi öne getirebilmek için -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <!-- Ekran kapalıyken alarmda ekranı uyandırabilmek için -->
    <!-- Rehberden numara/isim okumak için -->
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.DISABLE_KEYGUARD" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <application
        android:allowBackup="true"
        android:icon="@android:drawable/sym_def_app_icon"
        android:label="@string/app_name"
        android:theme="@style/Theme.WhatsAppScheduler"
        android:supportsRtl="true">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Görünmez köprü Activity: full-screen intent bildirimiyle ekran kapalı/
             kilitli olsa bile öne gelir, foreground'dan WhatsApp'ı güvenle tetikler -->
        <activity
            android:name=".WhatsAppLaunchActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:launchMode="singleInstance"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <!-- Görselleri WhatsApp'a paylaşabilmek için FileProvider -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- Kilit ekranı açılınca bekleyen mesajı gönderen servis -->
        <service
            android:name=".UnlockWaiterService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Zamanlanmis WhatsApp mesaji icin kilit acilmasini bekleme" />
        </service>

        <!-- Alarm tetiklendiğinde çalışan alıcı -->
        <receiver
            android:name=".AlarmReceiver"
            android:exported="false" />

        <!-- Telefon yeniden başlatıldığında alarmları geri kuran alıcı -->
        <receiver
            android:name=".BootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!-- WhatsApp arayüzünde "gönder" butonuna otomatik basan Erişilebilirlik servisi -->
        <service
            android:name=".WhatsAppAutoSendService"
            android:exported="false"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

    </application>
</manifest>
